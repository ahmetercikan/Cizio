{
  "rules": {
    "owners": {
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)"
      }
    },
    "allow": {
      "$room": {
        ".read": "auth != null && root.child('owners').child($room).val() === auth.uid",
        ".write": "auth != null && root.child('owners').child($room).val() === auth.uid"
      }
    },
    "presence": {
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('owners').child($pid).val() === auth.uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['room', 'ts']) && newData.child('room').isString() && newData.child('room').val().length < 40)"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && (root.child('owners').child($room).val() === auth.uid || root.child('allow').child($room).child(auth.uid).exists())",
        "looks": {
          "$pid": {
            ".write": "auth != null && root.child('owners').child($pid).val() === auth.uid && (root.child('owners').child($room).val() === auth.uid || root.child('allow').child($room).child(auth.uid).exists())"
          }
        },
        "live": {
          "$pid": {
            ".write": "auth != null && root.child('owners').child($pid).val() === auth.uid && (root.child('owners').child($room).val() === auth.uid || root.child('allow').child($room).child(auth.uid).exists())",
            ".validate": "!newData.exists() || (newData.hasChildren(['x', 'z', 'h', 'p']) && newData.child('x').isNumber() && newData.child('z').isNumber() && newData.child('p').isString() && newData.child('p').val().length < 12 && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 20)) && (!newData.child('w').exists() || (newData.child('w').isString() && newData.child('w').val().length < 10)))"
          }
        },
        "home": {
          ".write": "auth != null && root.child('owners').child($room).val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length < 20000"
        }
      }
    }
  }
}
